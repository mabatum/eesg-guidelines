lang: ru
linkify: true
allowHtml: false
allowCustomResources: true
no-index: true

interface:
  favicon-src: _assets/favicon.svg
  search: false

resources:
  style:
    - _assets/style/mobile-v2.css
    - _assets/style/search.css
    - _assets/style/page-meta.css
    - _assets/style/updates.css
    - _assets/style/page-nav.css
    - _assets/style/algorithm.css
    - _assets/style/homepage.css
    - _assets/style/internal-page-v2.css
  script:
    - _assets/script/search-index-v3.js
    - _assets/script/title-search-v3.js
    - _assets/script/header-nav-v2.js
    - _assets/script/page-meta.js
    - _assets/script/internal-page-v2.js
    - _assets/script/updates-page.js
    - _assets/script/page-nav.js
    - _assets/script/algorithm-ui.js
    - _assets/script/homepage.js
